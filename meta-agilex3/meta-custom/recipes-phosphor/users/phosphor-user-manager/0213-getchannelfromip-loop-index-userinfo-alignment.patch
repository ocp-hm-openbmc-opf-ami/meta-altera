Subject: [PATCH 213/213] getchannelfromip-loop-index-userinfo-alignment

---
 user_mgr.cpp | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/user_mgr.cpp b/user_mgr.cpp
index 35310bc..4d45ab9 100644
--- a/user_mgr.cpp
+++ b/user_mgr.cpp
@@ -2067,15 +2067,16 @@ uint8_t UserMgr::getChannelFromIP(const std::string& targetIp)
         }
 
         bool found = false;
-        std::optional<uint8_t> channel;
-        for (const auto& [ch, name] : channelMap)
+        uint8_t loopValue = 0;
+        for (const auto& [channelId, name] : channelMap)
         {
+            (void)channelId;
             if (name == baseIface)
             {
-                channel = ch;
                 found = true;
                 break;
             }
+            ++loopValue;
         }
 
         if (!found)
@@ -2091,7 +2092,7 @@ uint8_t UserMgr::getChannelFromIP(const std::string& targetIp)
             if (targetIp == ipStr)
             {
                 freeifaddrs(ifaddr);
-                return static_cast<int>(channel.value());
+                return loopValue;
             }
         }
         else if (ifa->ifa_addr->sa_family == AF_INET6)
@@ -2101,7 +2102,7 @@ uint8_t UserMgr::getChannelFromIP(const std::string& targetIp)
             if (targetIp == ipStr)
             {
                 freeifaddrs(ifaddr);
-                return static_cast<int>(channel.value());
+                return loopValue;
             }
         }
     }
@@ -2123,18 +2124,18 @@ UserInfoMap UserMgr::getUserInfo(std::string userName, std::string ipAddress)
     for (uint8_t value : currentPamOrder){
     if(value == 1){
         if (isUserExist(userName) &&
-            channelNo != std::numeric_limits<uint8_t>::max() && channelNo > 0)
+            channelNo != std::numeric_limits<uint8_t>::max())
         {
             const auto& user = usersList[userName];
             userChannelAccess.resize(std::max(userChannelAccess.size(),
-                                              static_cast<size_t>(channelNo)));
+                                              static_cast<size_t>(channelNo + 1)));
             userChannelAccess = user.get()->userChannelAccess();
-            if (userChannelAccess[channelNo - 1])
+            if (userChannelAccess[channelNo])
             {
                 std::vector<std::string> priv = user.get()->userPrivilege();
                 priv.resize(
-                    std::max(priv.size(), static_cast<size_t>(channelNo)));
-                userInfo.emplace("UserPrivilege", priv[channelNo - 1]);
+                    std::max(priv.size(), static_cast<size_t>(channelNo + 1)));
+                userInfo.emplace("UserPrivilege", priv[channelNo]);
                 userInfo.emplace("UserGroups", user.get()->userGroups());
                 userInfo.emplace("UserEnabled", user.get()->userEnabled());
                 userInfo.emplace("UserLockedForFailedAttempt",
