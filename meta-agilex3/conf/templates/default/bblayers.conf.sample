# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "16"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

# ---------------------------------------------------------------------------
# Required layers (in dependency order)
# ---------------------------------------------------------------------------
BBLAYERS ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/meta-openembedded/meta-oe \
  ##OEROOT##/meta-openembedded/meta-python \
  ##OEROOT##/meta-openembedded/meta-networking \
  ##OEROOT##/meta-openembedded/meta-filesystems \
  ##OEROOT##/meta-phosphor \
  ##OEROOT##/meta-arm/meta-arm \
  ##OEROOT##/meta-arm/meta-arm-bsp \
  ##OEROOT##/meta-arm/meta-arm-toolchain \
  ##OEROOT##/meta-intel-openbmc \
  ##OEROOT##/meta-ami \
  ##OEROOT##/meta-core \
  ##OEROOT##/meta-core/meta-common \
  ##OEROOT##/meta-altera/meta-altera-bsp \
  ##OEROOT##/meta-altera \
  ##OEROOT##/meta-altera/meta-common \
  ##OEROOT##/meta-altera/meta-altera-platform \
  ##OEROOT##/meta-altera/meta-agilex3 \
  ##OEROOT##/meta-altera/meta-agilex3/meta-custom \
  "
