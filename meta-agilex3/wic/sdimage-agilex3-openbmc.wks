# short-description: SD card image for Agilex 3 SoC running OpenBMC
# long-description: Creates a partitioned SD card image for the Agilex 3
# C-Series Development Kit (DK-A3W135BM16AEA) running OpenBMC phosphor.
# Partition 1: FAT32 boot (256 MB) - uboot.env, boot.scr.uimg, u-boot.itb, kernel.itb
# Partition 2: ext4 rootfs (1024 MB) - OpenBMC phosphor rootfs
# Flash: sudo dd if=obmc-phosphor-image-agilex3_openbmc.wic of=/dev/sdX bs=4M status=progress

part --source bootimg-partition --ondisk mmcblk --fstype=vfat --mkfs-extraopts "-F 32" --label boot --active --align 1024 --fixed-size 256M --system-id b

part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --align 1024 --fixed-size 1024M

